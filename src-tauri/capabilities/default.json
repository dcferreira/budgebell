{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the app windows opened from the tray and the scheduler-tick toast",
  "windows": ["custom-pause", "main", "settings", "stats", "toast"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-size",
    "opener:default"
  ]
}
