{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Budgebell",
  "version": "0.2.0",
  "identifier": "com.dcferreira.budgebell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGNUJGQTQ0QzkwMzE1MkUKUldRdUZRUEpSUHBibi9WNWtNS3ZZRnZReEZ1ZjFZL3h3VnZrOERxWG5EcWFhWHJTcHZNNVNkUVgK",
      "endpoints": ["https://github.com/dcferreira/budgebell/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
